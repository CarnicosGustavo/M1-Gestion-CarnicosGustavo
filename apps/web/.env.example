# =============================================================================
# Plantilla de variables de entorno (apps/web)
# Copiar a apps/web/.env.local y completar. SOLO nombres y marcadores:
# nunca pongas valores reales en este archivo ni en el repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno general
# -----------------------------------------------------------------------------
NODE_ENV=development

# URL base del despliegue (ej. http://localhost:3001 en local)
BASE_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Prefijo de ruta si la app no está en la raíz (ej. /app). Vacío = raíz.
BASE_PATH=

# Idioma de la interfaz (solo "es")
NEXT_PUBLIC_LOCALE=es

# -----------------------------------------------------------------------------
# Base de datos (Supabase / Postgres)
# -----------------------------------------------------------------------------
# Conexión que usa la app (en serverless, la cadena "transaction mode").
DATABASE_URL=postgres://<usuario>:<password>@<host>:<puerto>/<base>
# Opcional: conexión directa para drizzle-kit migrate. Si no se define, usa DATABASE_URL.
DATABASE_URL_MIGRATIONS=
# Opcional: TLS hacia Postgres. require (por defecto, como hasta ahora) | prefer | disable.
# "disable" solo para redes internas sin TLS (p. ej. Postgres en la misma red Docker).
DATABASE_SSL=
# Opcional: prepared statements. true | false. Si se deja vacío: false cuando la URL
# es del pooler de Supabase nube (pooler.supabase) y el valor por defecto de
# postgres-js en otro caso. Usa false detrás de un pooler en modo transacción
# (p. ej. Supavisor/PgBouncer en el puerto 6543).
DATABASE_PREPARE=
# Ojo: un valor inválido en DATABASE_SSL o DATABASE_PREPARE hace que la app falle al arrancar (a propósito).

# Semilla de datos demo al arrancar. En producción SIEMPRE "false".
RUN_SEED=false

# -----------------------------------------------------------------------------
# Autenticación (Better-Auth)
# -----------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3001
# Secreto para firmar sesiones (generar uno largo y aleatorio por entorno)
BETTER_AUTH_SECRET=<secreto-aleatorio>

# -----------------------------------------------------------------------------
# Rutas/acciones administrativas protegidas por token
# -----------------------------------------------------------------------------
# Token para /api/admin/* (seed, reset-stock, migrate-recipes)
SEED_TOKEN=
# Contraseña para operaciones de reinicio de inventario (si no se define, usa SEED_TOKEN)
ADMIN_RESET_PASSWORD=

# Variables introducidas por el PR de seguridad (#8):
# Token para /api/health/env y /api/health/schema (alternativa a sesión admin)
HEALTH_CHECK_TOKEN=
# Contraseña del usuario inicial al sembrar una base vacía (mín. 8 caracteres)
SEED_ADMIN_PASSWORD=
# Registro público por HTTP. Dejar sin definir (o "false") en producción.
ALLOW_PUBLIC_SIGNUP=

# -----------------------------------------------------------------------------
# Integraciones
# -----------------------------------------------------------------------------
# Motor de IA del asistente Antonella
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Seguridad (CORS)
# -----------------------------------------------------------------------------
# Origen permitido para peticiones externas (opcional)
CORS_ORIGIN=http://localhost:3001
